{
  "name": "@tachui/data",
  "version": "0.12.1",
  "description": "Data display and organization components for tachUI framework",
  "homepage": "https://tachui.dev/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./list": {
      "types": "./dist/list/index.d.ts",
      "import": "./dist/list/index.js"
    },
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "import": "./dist/menu/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && tsc --project tsconfig.build.json",
    "build:dev": "rm -rf dist && vite build --mode development && tsc --project tsconfig.build.json",
    "build:prod": "rm -rf dist && vite build --mode production && tsc --project tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "valid": "clear && vitest run && bun run type-check && bun run lint && bun run build",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ci": "npm run test:run",
    "type-check": "tsc --project tsconfig.type-check.json",
    "clean": "rm -rf dist",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@tachui/core": "0.12.1",
    "@tachui/flow-control": "0.12.1",
    "@tachui/mobile": "0.12.1",
    "@tachui/primitives": "0.12.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [
    "ui",
    "components",
    "data",
    "list",
    "menu",
    "tachui",
    "typescript"
  ],
  "author": "tachUI Team",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tach-UI/tachUI",
    "directory": "packages/data"
  }
}
