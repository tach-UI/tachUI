{
  "name": "@tachui/fragments",
  "version": "0.8.29",
  "description": "Fragments architecture for selective hydration in tachUI",
  "homepage": "https://tachui.dev/",
  "type": "module",
  "sideEffects": [
    "./dist/runtime.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && vite build && tsc --project tsconfig.build.json",
    "build:dev": "rm -rf dist tsconfig.build.tsbuildinfo && vite build --mode development && tsc --project tsconfig.build.json",
    "build:prod": "rm -rf dist tsconfig.build.tsbuildinfo && vite build --mode production && tsc --project tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "type-check": "tsc --project tsconfig.type-check.json",
    "clean": "rm -rf dist",
    "lint": "oxlint src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "dependencies": {
    "@tachui/core": "0.8.29",
    "@tachui/ssr": "0.8.29"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "tachui",
    "fragments",
    "hydration",
    "ssr"
  ],
  "author": "tachUI Team",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tach-UI/tachUI",
    "directory": "packages/fragments"
  },
  "publishConfig": {
    "access": "public"
  }
}
