{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@tachui/core": [
        "../core/dist/index.d.ts"
      ],
      "@tachui/core/*": [
        "../core/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "package.json"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "references": [
    {
      "path": "../core"
    }
  ]
}
