{
  "name": "@tachui/navigation",
  "version": "0.8.29",
  "description": "Navigation components for tachUI - NavigationView, TabView, and routing utilities",
  "homepage": "https://tachui.dev/",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./modifiers": {
      "types": "./dist/modifiers.d.ts",
      "import": "./dist/modifiers.js"
    },
    "./modifiers/register": {
      "types": "./dist/modifiers-register.d.ts",
      "import": "./dist/modifiers-register.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "import": "./dist/path.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json && node ./scripts/verify-build-artifacts.mjs",
    "build:dev": "rm -rf dist && vite build --mode development && tsc --project tsconfig.build.json && node ./scripts/verify-build-artifacts.mjs",
    "build:prod": "rm -rf dist && vite build --mode production && tsc --project tsconfig.build.json && node ./scripts/verify-build-artifacts.mjs",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "valid": "clear && vitest run && bun run type-check && bun run lint && bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "bench": "vitest bench",
    "benchmark": "vitest bench --config vitest.benchmark.config.ts benchmarks/navigation-performance.bench.ts",
    "benchmark:quick": "vitest bench --config vitest.benchmark.config.ts benchmarks/quick.bench.ts",
    "benchmark:bundle": "vitest bench --config vitest.benchmark.config.ts benchmarks/bundle-size.bench.ts",
    "benchmark:browser": "playwright test benchmarks/browser.spec.ts",
    "benchmark:all": "bun run benchmark && bun run benchmark:bundle && bun run benchmark:browser",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@tachui/modifiers": "workspace:*"
  },
  "peerDependencies": {
    "@tachui/core": ">=0.8.27"
  },
  "devDependencies": {
    "@tachui/core": "workspace:*",
    "@tachui/primitives": "workspace:*",
    "@types/node": "^20.0.0",
    "@playwright/test": "^1.40.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "tachui",
    "navigation",
    "swiftui",
    "web-framework",
    "typescript",
    "reactive"
  ],
  "author": "tachUI Team",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tach-UI/tachUI",
    "directory": "packages/navigation"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/modifiers-register.js"
  ]
}
