import { Layout, Text } from '@tachui/core'
import { State } from '@tachui/core/state'
import { Button } from '@tachui/primitives'

export function App() {
  const count = State(0)

  return Layout.VStack({
    children: [
      Text('TachUI Advanced Starter')
        .fontSize(30)
        .fontWeight('bold')
        .margin({ bottom: 12 }),

      Text(() => `Counter: ${count.wrappedValue}`)
        .fontSize(20)
        .margin({ bottom: 20 }),

      Layout.HStack({
        children: [
          Button('-', () => {
            count.wrappedValue -= 1
          })
            .padding(10, 14)
            .cornerRadius(8),

          Button('+', () => {
            count.wrappedValue += 1
          })
            .padding(10, 14)
            .cornerRadius(8),
        ],
        spacing: 12,
        alignment: 'center',
      }),
    ],
    spacing: 0,
    alignment: 'center',
  })
    .frame(undefined, '100vh')
    .justifyContent('center')
    .alignItems('center')
}
