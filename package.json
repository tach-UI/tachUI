{
  "name": "tachui",
  "version": "0.8.14",
  "description": "A SwiftUI-inspired web framework with SolidJS-style reactivity",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "bun run build:types && bun run build:registry && bun run build:core && bun run build:modifiers && bun run build:packages",
    "build:dev": "clear && rm -rf dist node_modules/.vite-temp node_modules/.vite && bun run build",
    "build:prod": "bun run build",
    "build:packages": "bun run build:ssr && bun run build:mobile && bun run build:flow-control && bun run build:viewport && bun run build:primitives && bun run build:responsive && bun run build:symbols && bun run build:data && bun run build:forms && bun run build:navigation && bun run build:grid && bun run build:devtools && bun run build:cli && bun run build:fragments",
    "build:fragments": "bun run --filter @tachui/fragments build",
    "build:registry": "bun run --filter @tachui/registry build",
    "build:clean": "clear && rm -rf dist node_modules/.vite-temp node_modules/.vite && bun run test && bun run lint && bun run type-check && bun run build:dev",
    "build:types": "bun run --filter @tachui/types build",
    "build:core": "bun run build:types && bun run --filter @tachui/core build",
    "build:mobile": "bun run --filter @tachui/mobile build",
    "build:flow-control": "bun run --filter @tachui/flow-control build",
    "build:viewport": "bun run --filter @tachui/viewport build",
    "build:modifiers": "bun run --filter @tachui/modifiers build",
    "build:primitives": "bun run --filter @tachui/primitives build",
    "build:responsive": "bun run --filter @tachui/responsive build",
    "build:symbols": "bun run --filter @tachui/symbols build",
    "build:data": "bun run --filter @tachui/data build",
    "build:forms": "bun run --filter @tachui/forms build",
    "build:navigation": "bun run --filter @tachui/navigation build",
    "build:grid": "bun run --filter @tachui/grid build",
    "build:devtools": "bun run --filter @tachui/devtools build",
    "build:ssr": "bun run --filter @tachui/ssr build",
    "build:cli": "bun run --filter @tachui/cli build",
    "dev": "bun run --filter '*' --parallel dev",
    "test": "vitest run && bun run test:tools",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:ci": "vitest run --config=vitest.ci.config.ts && bun run test:tools && bun run --filter @tachui/modifiers verify:tree-shaking",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "test:long": "vitest run packages/core/__tests__/integration/long-running-simulation.test.ts packages/core/__tests__/security/malicious-plugin-detection.test.ts packages/core/__tests__/security/sandbox-security.test.ts",
    "test:error-recovery": "vitest run packages/core/__tests__/integration/error-recovery.test.ts",
    "test:coverage": "vitest run --coverage",
    "bench": "bun run --filter '*' bench",
    "benchmark": "bun run --filter @tachui/core benchmark",
    "benchmark:quick": "bun run --filter @tachui/core benchmark:quick",
    "benchmark:compare": "bun run --filter @tachui/core benchmark:compare",
    "benchmark:browser": "bun run --filter @tachui/core benchmark:browser",
    "benchmark:browser:quick": "bun run --filter @tachui/core benchmark:browser:quick",
    "benchmark:browser:report": "bun run --filter @tachui/core benchmark:browser:report",
    "benchmark:report:combined": "tsx --tsconfig ./tools/benchmarks/tsconfig.benchmark.json ./tools/benchmarks/core-benchmark.ts",
    "benchmark:report": "bun run benchmark:report:combined",
    "benchmark:navigation": "bun run --filter @tachui/navigation benchmark",
    "benchmark:navigation:quick": "bun run --filter @tachui/navigation benchmark:quick",
    "benchmark:navigation:bundle": "bun run --filter @tachui/navigation benchmark:bundle",
    "benchmark:navigation:all": "bun run --filter @tachui/navigation benchmark:all",
    "test:memory-leaks": "FORCE_MEMORY_TESTS=true vitest run packages/core/__tests__/integration/memory-leak-component.test.ts",
    "docs:dev": "bun run --filter @tachui/docs dev",
    "docs:build": "bun run --filter @tachui/docs build",
    "docs:api": "typedoc",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release:version": "changeset version && node ./tools/rewrite-workspace-deps.mjs && bun install",
    "release:verify:version-line": "node ./tools/check-version-line.mjs",
    "release:verify:internal-deps": "bun run release:verify:version-line && node ./tools/check-dep-protocols.mjs && node ./tools/check-packed-internal-deps.mjs && node ./tools/check-published-internal-deps.mjs",
    "release:smoke": "./tools/smoke-cli-init-packed.sh",
    "release:publish": "bun run release:verify:internal-deps && bun run release:smoke && bun run changeset:publish",
    "ci:check-changesets": "node ./tools/check-changesets.mjs",
    "ci:check-readme-pins": "node ./tools/check-readme-version-pins.mjs",
    "ci:check-version-line": "node ./tools/check-version-line.mjs",
    "ci:check-side-effects": "node ./tools/check-side-effects.mjs",
    "lint": "oxlint packages --import-plugin --ignore-pattern='**/__tests__/**' --ignore-pattern='**/*.test.*' --ignore-pattern='**/*.spec.*'",
    "lint:fix": "oxlint packages --import-plugin --ignore-pattern='**/__tests__/**' --ignore-pattern='**/*.test.*' --ignore-pattern='**/*.spec.*' --fix",
    "type-check": "bun run --filter '*' type-check",
    "clean": "bun run --filter '*' clean",
    "dev:docs": "bun run --filter @tachui/docs dev",
    "dev:core": "bun run --filter @tachui/core dev",
    "dev:cli": "bun run --filter @tachui/cli dev",
    "dev:navigation": "bun run --filter @tachui/navigation dev",
    "dev:symbols": "bun run --filter @tachui/symbols dev",
    "validate:workspace-aliases": "tsx tools/validate-workspace-aliases.ts",
    "validate:workspace-aliases:fix": "tsx tools/validate-workspace-aliases.ts --fix",
    "prepare": "simple-git-hooks"
  },
  "workspaces": [
    "packages/*",
    "docs/guide"
  ],
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@changesets/cli": "^2.29.6",
    "@changesets/changelog-github": "^0.5.1",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.21.0",
    "glob": "^10.4.5",
    "jsdom": "^23.2.0",
    "lint-staged": "^15.2.0",
    "oxlint": "^1.12.0",
    "simple-git-hooks": "^2.9.0",
    "semver": "^7.7.2",
    "tsx": "^4.19.1",
    "typedoc": "^0.28.10",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.8.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run type-check && bun run test:ci"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.2.0",
  "dependencies": {
    "lucide": "^0.447.0"
  }
}
